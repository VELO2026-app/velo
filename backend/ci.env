# VELO -- the one settings environment of CI and of a local run (BE-190 fix)
#
# Invented values for every required key of the backend's Settings, so the
# app can be imported and the suite can start where no passport exists:
#   - ci.yml, the step that regenerates generated.ts (drift-check);
#   - backend-tests.yml, the suite (docker run --env-file);
#   - an executor's local run: set -a; . backend/ci.env; set +a, then the
#     place's own addresses (par0 §14).
# NOT HERE: the connection addresses (DATABASE_URL, REDIS_URL) -- every place
# has its own; PRIMER_RELEASE/PRIMER_COMMIT -- the image's ENV carries them,
# and a place without the image sets its own.
# backend/tests/test_primer_env.py keeps this file and Settings in step, and
# checks that both CI places read it.
#
# Format: KEY=value, one per line, no quotes and no spaces -- docker's
# --env-file takes a line literally, and the shell sources the same file.
SERVER_ROLE=test
EDITION=ai
DOMAIN_FRONTEND=app.velo-ci.invalid
DOMAIN_API=api.velo-ci.invalid
TELEGRAM_BOT_TOKEN=123456:velo-ci-bot-token
TELEGRAM_LOGIN_CLIENT_ID=123456
TELEGRAM_LOGIN_CLIENT_SECRET=velo-ci-login-secret
ZOOM_ACCOUNT_ID=velo-ci-zoom-account
ZOOM_CLIENT_ID=velo-ci-zoom-client
ZOOM_CLIENT_SECRET=velo-ci-zoom-secret
ZOOM_SDK_CLIENT_ID=velo-ci-zoom-sdk-client
ZOOM_SDK_CLIENT_SECRET=velo-ci-zoom-sdk-secret
