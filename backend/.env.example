# =============================================================================
# VELO Backend — Environment Variables
# =============================================================================
# On VPS: auto-generated by install_velo.sh with random passwords.
# Hosts are Docker service names (postgres, redis) — NOT localhost.
# =============================================================================

APP_ENV=development

# Database — host "postgres" = Docker service name
# T-14: the app now refuses to start in production if these placeholder
# values (change-me / change-me-in-production) are still live -- see
# app/core/config.py's placeholder_secret_keys. Those literals are
# DUPLICATED there, not read from this file: change a value here, change
# it in config.py too, or the gate goes quietly blind (kept honest by
# test_config.py's sync test).
DATABASE_URL=postgresql+asyncpg://velo:change-me@postgres:5432/velo
POSTGRES_DB=velo
POSTGRES_USER=velo
POSTGRES_PASSWORD=change-me

# Redis — host "redis" = Docker service name
# REDIS_PASSWORD is also read by docker-compose to start Redis with --requirepass.
# NOT covered by the T-14 gate above (no Settings field for it) -- covered
# indirectly via REDIS_URL, which embeds the same value by convention.
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me

# CORS
CORS_ORIGINS=*

# Public link base — the origin every /z/{code} practice link is built
# from (T-35). Written by install_velo.sh: the optional short domain if
# one was given at install, the API domain otherwise; nginx proxies "/"
# on that host to this backend, so the root-level route publishes itself.
# REQUIRED in production — the app refuses to start with it empty, because
# a wrong base means links already posted in Telegram channels lead
# nowhere and nothing at runtime would say so.
PUBLIC_LINK_BASE=https://api.example.com

# Security — generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# T-14: this placeholder value is duplicated in app/core/config.py's
# placeholder_secret_keys -- change it here, change it there too, or the
# startup gate goes quietly blind (kept honest by test_config.py's sync test).
SECRET_KEY=change-me-in-production

# Telegram
TELEGRAM_BOT_TOKEN=
# Bot URL for notification deep links. Username resolved via Telegram getMe.
TELEGRAM_BOT_URL=
# Live Telegram link host. The backend rewrites every Telegram URL onto it --
# both the bot URL above and the avatar URLs Telegram sends in initData.
TELEGRAM_LINK_DOMAIN=

# Session TTL (days)
SESSION_TTL_DAYS=30

# Logging
LOG_LEVEL=DEBUG

# Stripe (Phase 6.3) — set STRIPE_SECRET_KEY=TEST + ALLOW_STRIPE_STUB=true to
# run with the stub path (fake payments, no money moves, no real key needed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Written by install_velo.sh's generate_env, but not a field on Settings in
# config.py -- nothing in the backend currently reads it. Kept here because
# this file's job is to document what the installer actually writes, not
# just what the app consumes.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
ALLOW_STRIPE_STUB=false

# Zoom (Server-to-Server OAuth app in the Zoom marketplace). Blank values,
# or ZOOM_CLIENT_SECRET=TEST, mean STUB MODE: meetings are fabricated
# zoom.us URLs that look plausible and open nothing, no registrant is ever
# matched, and attendance is never recorded for anybody.
#
# In production the backend REFUSES TO START in that state unless
# ALLOW_ZOOM_STUB=true says the stub is intended. A server was found
# running for weeks on the stub with nobody aware -- the links looked real
# in the UI and nothing anywhere said otherwise. Silence was the defect.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=TEST
ALLOW_ZOOM_STUB=false
# Zoom inside the app (Meeting SDK, Standalone F4). A SECOND Zoom app: a
# General App in the same Zoom account with Features -> Embed -> Meeting
# SDK switched on. Its App Credentials page, Development column:
#   ZOOM_SDK_CLIENT_ID     -- Client ID
#   ZOOM_SDK_CLIENT_SECRET -- Client Secret (signs the SDK JWT, server only)
# OPTIONAL: while either is unset (or Zoom above is the stub), the practice
# screen says "Zoom inside the app is not configured on this server" and
# nobody can enter -- `velo update` is not blocked by their absence. On a
# live server: `velo env set <KEY>` (value read hidden), then `velo restart`.
# The master starts his meeting with a ZAK that the Server-to-Server app
# above reads: that app also needs the scope user:read:token:admin.
# (optional) ZOOM_SDK_CLIENT_ID=
# (optional) ZOOM_SDK_CLIENT_SECRET=
# Comms integration (Phase 6) — written by the Phase 5 installer hand-over
# (comms-deploy.sh install, pass 2). Leave EMPTY when comms is not installed
# on this box: the relay logs "disabled" and the notification proxy answers
# 502; velo runs fine either way. In production the config validator enforces
# pairing: a set COMMS_API_URL needs COMMS_SERVICE_TOKEN, and an enabled relay
# needs COMMS_REDIS_URL (a half-config is a silent failure otherwise).
#
# HTTP proxy (read path: inbox / badge / prefs):
COMMS_API_URL=
COMMS_SERVICE_TOKEN=
COMMS_HTTP_TIMEOUT_SECONDS=5
# Outbox relay (write path: domain events -> comms Redis Stream):
COMMS_REDIS_URL=
COMMS_RELAY_ENABLED=true
# Stream name -- MUST match the comms consumer's stream (lockstep with the
# comms .env); the shared default is comms:events.
COMMS_EVENTS_STREAM=comms:events

# Voice transcription (GT-41). The key is READ BY THE SERVER and never
# reaches the browser -- that is the whole point of the endpoint. Empty key:
# the mic still records, and the request comes back with
# transcription_not_configured instead of a transcript. Use a key with a
# spend cap anyway: nothing here limits how much one person can transcribe.
OPENROUTER_API_KEY=
# Optional -- config.py falls back to openai/gpt-audio-mini.
OPENROUTER_TRANSCRIBE_MODEL=
OPENROUTER_HTTP_TIMEOUT_SECONDS=25

# Support translation (BE-166): the ONE language support admins write in --
# users' messages are translated into it, replies out of it into each
# user's language. One of en, de, es, ru, uk, or the backend refuses to
# start. Unset: en. A comment line on purpose, like the MCP keys below --
# `velo update` checks only uncommented keys, so a box without it updates.
# On a live server: `velo env set SUPPORT_LANGUAGE`.
# (optional) SUPPORT_LANGUAGE=

# Support spam bin (BE-162 delivery 2): a ticket marked spam is deleted with
# its conversation this many days after it was marked (owner ruling: 30);
# until then an admin can bring it back ("not spam"). Unset: 30. A comment
# line on purpose, like SUPPORT_LANGUAGE above. To watch the bin empty on a
# stand without waiting a month: `velo env set SUPPORT_SPAM_RETENTION_DAYS`
# with 0, then `velo restart` (not `velo restart app`: that restarts the
# container without reading backend/.env again) -- and back: the same with
# 30 (an empty value also means 30), then `velo restart`.
# (optional) SUPPORT_SPAM_RETENTION_DAYS=

# MCP OAuth (BE-141): claude.ai connects to /mcp with a button, the student
# signs in with Telegram ("Log In With Telegram", OpenID Connect). OPTIONAL:
# while any of the three is unset, OAuth is off -- its routes answer 404 and
# /mcp keeps working with personal tokens. They are declared as
# "# (optional) KEY=" lines on purpose: `velo update` checks only the
# uncommented keys, so their absence never blocks an update. A fresh install
# writes them: the issuer derived from the API domain, the two Telegram keys
# asked (both or neither). On a live server: `velo env set <KEY>` (the value
# is read hidden), then `velo restart`; `velo doctor` shows what is missing.
#   MCP_OAUTH_ISSUER_URL         -- https origin of this API, e.g.
#                                   https://api.example.com
#   TELEGRAM_LOGIN_CLIENT_ID     -- BotFather -> the bot -> Login Widget:
#   TELEGRAM_LOGIN_CLIENT_SECRET    Client ID and Client Secret
# (optional) MCP_OAUTH_ISSUER_URL=
# (optional) TELEGRAM_LOGIN_CLIENT_ID=
# (optional) TELEGRAM_LOGIN_CLIENT_SECRET=
# Hosts whose Client ID Metadata Documents are trusted (comma-separated).
# Default: claude.ai,chatgpt.com. Leave it unset; set it only if a
# connector fails with mcp_oauth_cimd_refused reason=host_not_allowed in
# the app log for a host it should know. An EMPTY value is not the
# default: it trusts no host, and claude.ai and ChatGPT both stop connecting.
# (optional) MCP_OAUTH_CIMD_ALLOWED_HOSTS=

# Object storage (BE-133): the secret of the backend's own key to velo-storage
# (the key's name is fixed in app/core/storage_registry.yaml). NOBODY TYPES IT:
# `velo update` and the installer write a fresh one here when it is absent,
# and the storage init sets the storage to it on every run. To rotate it:
# `velo env set STORAGE_SECRET_KEY` (8..40 characters, no '=' or ','), then
# `velo update`. Declared "# (optional)" so that an older update script's
# drift check does not stop the deploy that brings it. The storage's ROOT key
# is not here and never will be: it lives in /opt/velo/storage.env, which the
# app container does not see.
# (optional) STORAGE_SECRET_KEY=
