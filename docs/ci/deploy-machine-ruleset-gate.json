{
  "name": "deploy-machine: PR only, required checks, merge commit (FE-222)",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/deploy-machine"],
      "exclude": []
    }
  },
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request" },
    { "actor_id": 1, "actor_type": "OrganizationAdmin", "bypass_mode": "pull_request" },
    { "actor_id": null, "actor_type": "DeployKey", "bypass_mode": "always" }
  ],
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "CI — gate", "integration_id": 15368 },
          { "context": "bundle budget guard", "integration_id": 15368 },
          { "context": "visual — verdict", "integration_id": 15368 },
          { "context": "commit subjects", "integration_id": 15368 }
        ]
      }
    }
  ]
}
