{
  "name": "@velo/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VELO UI kit -- private workspace package (tz-ui-package.md). Stub skeleton in P1: tooling, folder structure, token contract and Storybook; components migrate in P2-P6 batches.",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/velo-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write src/ .storybook/",
    "format:check": "prettier --check src/ .storybook/",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@storybook/vue3-vite": "10.6.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^15.15.0",
    "happy-dom": "^21.0.4",
    "postcss-html": "^2.0.0",
    "prettier": "^3.5.0",
    "storybook": "10.6.2",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "7.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24"
  }
}
