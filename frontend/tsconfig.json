{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",

    /* Module Resolution */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    /* Strictness — like mypy strict for Python */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    /* Emit */
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* Path aliases (relative to this file; TS 6 deprecates baseUrl) — import from '@/stores/auth' instead of '../../../stores/auth' */
    "paths": {
      "@/*": ["./src/*"],
      // FE-117 batch A: the app compiles the kit's SOURCES (see the package
      // README CSS section) -- exact key, no deep subpaths allowed.
      "@velo/ui": ["../packages/velo-ui/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
