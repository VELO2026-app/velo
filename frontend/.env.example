# =============================================================================
# VELO Frontend -- Environment Variables
# =============================================================================
# Copy to .env and fill in values.
# Only variables prefixed with VITE_ are exposed to the browser.
# =============================================================================

# Backend API base URL (no trailing slash).
# In Docker/production: empty (Nginx proxies /api/* to backend).
# For local dev against remote: https://api.talentir.info
VITE_API_BASE_URL=

# Telegram bot of this instance (universal link). Default:
# https://telegram.me/veloappbot
VITE_TELEGRAM_BOT_URL=

# -----------------------------------------------------------------------------
# Instance passport (tz-whitelabel §1). All optional: absent values build the
# golden VELO build. One codebase -> N branded builds; no code edits.
# -----------------------------------------------------------------------------
# Display name: <title> in index.html, manifest name/short_name, {brand} in
# messages. Default: VELO
#VITE_BRAND=VELO
# UI language. Also <html lang> in index.html and i18n fallbackLocale.
# One of: ru | en | uk | de | es. Default: ru
#VITE_DEFAULT_LOCALE=ru
# Comma list of locale chunks the build ships (tz-i18n 0.5). Default: ru
#VITE_LOCALES=ru
# Enabled modules for editions (tz-whitelabel F3): 'full' or a comma list
# ('payments', 'ai', ...). Default: full
#VITE_FEATURES=full
