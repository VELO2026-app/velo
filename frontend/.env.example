# =============================================================================
# VELO Frontend -- Environment Variables
# =============================================================================
# Copy to .env and fill in values.
# Only variables prefixed with VITE_ are exposed to the browser.
# =============================================================================

# Backend API base URL (no trailing slash).
# In Docker/production: empty (Nginx proxies /api/* to backend).
# For local dev against remote: https://api.talentir.info
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Voice input (MVP): transcription goes straight from the browser to OpenRouter.
#
# WARNING: a VITE_* value is compiled INTO the client bundle -- treat the key
# as PUBLIC. Use a dedicated key with a hard spend cap (OpenRouter -> Keys ->
# Limit), rotate it freely, and never a production/personal one. Empty value
# disables transcription honestly: the mic answers «Голосовой ввод недоступен».
# -----------------------------------------------------------------------------
VITE_OPENROUTER_API_KEY=
# Optional. Defaults to openai/gpt-audio-mini when empty.
VITE_OPENROUTER_TRANSCRIBE_MODEL=
