{
  // Build-tooling files outside src/: the .mjs scripts (plain JS, checked via
  // checkJs) and the Vite/Vitest configs. Separate from tsconfig.json because
  // the app config targets the browser and has no Node types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    /* checkJs on untyped scripts: params stay implicit any; the rest of strict applies */
    "noImplicitAny": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@velo/ui": ["../packages/velo-ui/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.mjs", "vite.config.ts", "vitest.config.ts", "env.d.ts"]
}
