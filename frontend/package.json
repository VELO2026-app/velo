{
  "name": "velo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-skin.mjs --build && vue-tsc --noEmit --incremental && vite build",
    "preview": "vite preview",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "verify:quick": "node scripts/verify-quick.mjs",
    "lint": "node scripts/lint-budget.mjs && node scripts/no-cyrillic.mjs && node scripts/brand-grep.mjs && node scripts/key-audit.mjs && node scripts/doc-coverage.mjs && node scripts/api-type-dupes.mjs && pnpm lint:css",
    "lint:css": "node scripts/css-lint.mjs",
    "skin": "node scripts/apply-skin.mjs",
    "build:matrix": "node scripts/build-matrix.mjs",
    "checklist:instance": "node scripts/instance-checklist.mjs",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/ e2e/ scripts/",
    "format:check": "prettier --check src/ e2e/ scripts/",
    "typecheck": "vue-tsc --noEmit --incremental && tsc -p tsconfig.scripts.json && tsc -p tsconfig.configs.json && tsc --noEmit -p e2e/tsconfig.json",
    "docs": "typedoc",
    "test": "vitest run && node --test scripts/lib/*.test.mjs",
    "test:watch": "vitest",
    "tokens:sync": "node scripts/sync-figma-variables.mjs --rest",
    "test:coverage": "vitest run --coverage && node --test scripts/lib/*.test.mjs",
    "coverage:budget": "node scripts/coverage-budget.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@pinia/colada": "1.4.8",
    "@tma.js/sdk-vue": "^1.0.19",
    "@velo/ui": "workspace:*",
    "@vue/devtools-api": "8.2.1",
    "@zoom/meetingsdk": "6.5.0",
    "lodash": "4.18.1",
    "luxon": "^3.7.2",
    "pinia": "^4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "8.1.3",
    "redux": "4.2.1",
    "redux-thunk": "2.4.2",
    "vue": "^3.5.0",
    "vue-i18n": "11.4.16",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@intlify/unplugin-vue-i18n": "11.2.7",
    "@playwright/test": "1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.20.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^15.15.0",
    "happy-dom": "^21.0.4",
    "postcss-html": "^2.0.0",
    "prettier": "^3.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24"
  }
}
